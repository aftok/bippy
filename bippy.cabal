cabal-version:       3.0
name:                bippy
version:             0.3.2.0
synopsis:            An implementation of the BIP-70/71/72 Bitcoin Payment Protocol in Haskell
homepage:            https://github.com/aftok/bitcoin-pp
license:             MIT
license-file:        LICENSE
author:              Kris Nuttycombe
maintainer:          kris@aftok.com
category:            Bitcoin, Finance
build-type:          Simple

common buildenv
  default-language:   Haskell2010
  default-extensions: OverloadedStrings
                    , ScopedTypeVariables
  ghc-options:        -Wall -Werror
  build-depends:
    base                  >= 4.16 && < 4.21,
    bytestring            >= 0.11 && < 0.13,
    mtl                   >= 2.2 && < 2.4,
    transformers          >= 0.5 && < 0.7,
    cereal                >= 0.5 && < 0.6,
    cryptonite            >= 0.30 && < 0.35,
    either                >= 5.0 && < 5.1,
    text                  >= 1.2 && < 2.2,
    haskoin-core          >= 1.0 && < 1.3,
    secp256k1-haskell     >= 1.0 && < 2.0,
    time                  >= 1.11 && < 1.15,
    string-conversions    >= 0.4 && < 0.5,
    lens                  >= 5.1 && < 5.4,
    network-uri           >= 2.6 && < 2.8,
    optparse-applicative  >= 0.17 && < 0.19,
    protobuf              >= 0.2 && < 0.4,
    quickcheck-instances  >= 0.3 && < 0.4,
    x509                  >= 1.7 && < 1.9,
    x509-store            >= 1.6 && < 1.8,
    QuickCheck            >= 2.14 && < 2.16,

library
  import:             buildenv
  hs-source-dirs:     src
  exposed-modules:     
    Bippy
    Bippy.Proto
    Bippy.Constants
    Bippy.Types
    Bippy.Test.Types
    Bippy.Test.Proto

executable bippy-cli
  import:             buildenv
  hs-source-dirs:     app
  main-is:            Main.hs
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N -Wall 
                      -Werror
  build-depends: bippy

test-suite bippy-test
  import:             buildenv
  hs-source-dirs:     test
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N -Wall -Werror
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  other-modules:     
    Bippy.Tests
  build-depends:      
    bippy,
    HUnit,
    test-framework,
    test-framework-quickcheck2,
    test-framework-hunit,
